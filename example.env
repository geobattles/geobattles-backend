# Local development template. Prefer: make setup
# Never reuse production credentials. Keep the generated .env private.
DB_HOST=127.0.0.1
DB_USER=geobattles_dev
DB_NAME=geobattles_dev

# Generated value must be exactly 64 lowercase hexadecimal characters.
DB_PASSWORD=

# Required before process startup; generate at least 32 random characters.
JWT_KEY=
LISTEN_ADDR=127.0.0.1:8080
LOG_LEVEL=INFO

# Google Street View Static API key. Leave blank for foundation checks.
# make dev withholds this key; make dev-maps enables it for approved manual play.
GMAPS_API=
